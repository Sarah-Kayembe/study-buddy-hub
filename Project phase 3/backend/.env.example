# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=StudyBuddy

# Default Admin User (auto-created on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# Flask session signing key (use a long random string)
SECRET_KEY=change-me

# Logging verbosity: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO
